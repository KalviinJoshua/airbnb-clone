# ==============================================================================
# Airbnb Clone Backend Environment Variables (Production & Development Example)
# Copy this file to .env and replace all placeholders with your actual values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (Comma-separated for multiple origins, no wildcards in prod)
# Local: http://localhost:5173
# Production (Render): https://your-frontend-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection String
# Get this from Atlas Dashboard -> Database -> Connect -> Connect your application (Drivers)
# Replace <username>, <password>, and <dbname>
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication Configuration
# Generate a strong 64-character random string (e.g. using `openssl rand -hex 32`)
JWT_SECRET=your_long_random_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Host Role Security & Administrative Access Controls
# Secret passcode required to register or elevate an account to Host privileges
HOST_REGISTRATION_SECRET=your_secure_host_invitation_secret_here

# Optional: Comma-separated list of pre-authorized host email addresses
# e.g.: host1@example.com,admin@company.com
TRUSTED_HOST_EMAILS=
