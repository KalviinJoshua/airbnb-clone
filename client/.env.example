# ==============================================================================
# Airbnb Clone Frontend Environment Variables (Production & Development Example)
# Copy this file to .env and replace all placeholders with your actual values.
# NEVER include backend secrets or database credentials in this file.
# ==============================================================================

# Backend API Base URL (including /api path)
# Local Development: http://localhost:5000/api
# Production (Vercel): https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api
